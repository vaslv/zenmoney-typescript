# Chrome for Testing 120 is available for Linux amd64 only.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:7852dc5a7d72f5fe458a597d690f6c42fbc8e9e26ddfa95f8e6ef552558d9bbf
WORKDIR /app
ENV XDG_CONFIG_HOME=/tmp/chrome-config XDG_CACHE_HOME=/tmp/chrome-cache
ENV npm_config_cache=/opt/npm-cache npm_config_update_notifier=false
RUN curl -fsSL https://storage.googleapis.com/chrome-for-testing-public/120.0.6099.109/linux64/chrome-linux64.zip -o /tmp/chrome.zip \
    && echo 'bcb22c5242aabf184c6fadd86ee58b3ae35739177edac9de3938ed33791d4ddf  /tmp/chrome.zip' | sha256sum -c - \
    && python3 -m zipfile -e /tmp/chrome.zip /opt/chrome120 \
    && chmod +x /opt/chrome120/chrome-linux64/chrome /opt/chrome120/chrome-linux64/chrome_crashpad_handler /opt/chrome120/chrome-linux64/chrome_sandbox && rm /tmp/chrome.zip
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache add lossless-json@4.3.2
COPY . .
RUN npm run build && npm run build:spikes
ENV CHROME_EXECUTABLE=/opt/chrome120/chrome-linux64/chrome
CMD ["xvfb-run", "-a", "node", "tests/browser/run.mjs"]
